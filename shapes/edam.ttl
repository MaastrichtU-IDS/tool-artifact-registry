<http://edamontology.org/data_3671> a skos:Concept ;
    skos:prefLabel "Text" ;
    skos:definition "Any free or plain text, typically for human consumption and in English. Can instantiate also as a textual search query." ;
    skos:altLabel "Free text" ;
    skos:altLabel "Textual search query" ;
    skos:altLabel "Plain text" ;
