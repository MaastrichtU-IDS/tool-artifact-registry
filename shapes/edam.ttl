    skos:altLabel "CLIP" ;
    skos:altLabel "PAR-CLIP" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3796> a skos:Concept ;
    skos:prefLabel "Population genomics" ;
    skos:definition "Large-scale study (typically comparison) of DNA sequences of populations." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3810> a skos:Concept ;
    skos:prefLabel "Agricultural science" ;
    skos:definition "Multidisciplinary study, research and development within the field of agriculture." ;
    skos:altLabel "Agriculture" ;
    skos:altLabel "Agronomy" ;
    skos:altLabel "Agroecology" ;
    skos:altLabel "Animal breeding" ;
    skos:altLabel "Food security" ;
    skos:altLabel "Phytomedicine" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3837> a skos:Concept ;
    skos:prefLabel "Metagenomic sequencing" ;
    skos:definition "Approach which samples, in parallel, all genes in all organisms present in a given sample, e.g. to provide insight into biodiversity and function." ;
    skos:altLabel "Shotgun metagenomic sequencing" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3855> a skos:Concept ;
    skos:prefLabel "Environmental science" ;
    skos:definition "Study of the environment, the interactions between its physical, chemical, and biological components and it's effect on life.  Also how humans impact upon the environment, and how we can manage and utilise natural resources." ;
    skos:altLabel "Environment" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3892> a skos:Concept ;
    skos:prefLabel "Biomolecular simulation" ;
    skos:definition "The study and simulation of molecular conformations using a computational model and computer simulations." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3895> a skos:Concept ;
    skos:prefLabel "Synthetic biology" ;
    skos:definition "The application of multi-disciplinary science and technology for the construction of artificial biological systems for diverse applications." ;
    skos:altLabel "Biomimeic chemistry" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3912> a skos:Concept ;
    skos:prefLabel "Genetic engineering" ;
    skos:definition "The application of biotechnology to directly manipulate an organism's genes." ;
    skos:altLabel "Genetic modification" ;
    skos:altLabel "Genetic manipulation" ;
    skos:altLabel "Genome engineering" ;
    skos:altLabel "Genome editing" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3922> a skos:Concept ;
    skos:prefLabel "Proteogenomics" ;
    skos:definition "A field of biological research focused on the discovery and identification of peptides, typically by comparing mass spectra against a protein database." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3930> a skos:Concept ;
    skos:prefLabel "Immunogenetics" ;
    skos:definition "A biomedical field that bridges immunology and genetics, to study the genetic basis of the immune system." ;
    skos:altLabel "Immunology and genetics" ;
    skos:altLabel "Immungenetics" ;
    skos:altLabel "Immune system genetics" ;
    skos:altLabel "Immunogenes" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3934> a skos:Concept ;
    skos:prefLabel "Cytometry" ;
    skos:definition "Cytometry is the measurement of the characteristics of cells." ;
    skos:altLabel "Flow cytometry" ;
    skos:altLabel "Mass cytometry" ;
    skos:altLabel "Image cytometry" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3940> a skos:Concept ;
    skos:prefLabel "Chromosome conformation capture" ;
    skos:definition "Molecular biology methods used to analyze the spatial organization of chromatin in a cell." ;
    skos:altLabel "3C-based methods" ;
    skos:altLabel "3C technologies" ;
    skos:altLabel "Chromosome conformation analysis" ;
    skos:altLabel "Chromatin accessibility" ;
    skos:altLabel "Chromatin accessibility assay" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3941> a skos:Concept ;
    skos:prefLabel "Metatranscriptomics" ;
    skos:definition "The study of microbe gene expression within natural environments (i.e. the metatranscriptome)." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3943> a skos:Concept ;
    skos:prefLabel "Paleogenomics" ;
    skos:definition "The reconstruction and analysis of genomic information in extinct species." ;
    skos:altLabel "Ancestral genomes" ;
    skos:altLabel "Paleogenetics" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3944> a skos:Concept ;
    skos:prefLabel "Cladistics" ;
    skos:definition "The biological classification of organisms by categorizing them in groups (\"clades\") based on their most recent common ancestor." ;
    skos:altLabel "Tree of life" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3945> a skos:Concept ;
    skos:prefLabel "Molecular evolution" ;
    skos:definition "The study of the process and mechanism of change of biomolecules such as DNA, RNA, and proteins across generations." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3948> a skos:Concept ;
    skos:prefLabel "Immunoinformatics" ;
    skos:definition "Immunoinformatics is the field of computational biology that deals with the study of immunoloogical questions. Immunoinformatics is at the interface between immunology and computer science. It takes advantage of computational, statistical, mathematical approaches and enhances the understanding of immunological knowledge." ;
    skos:altLabel "Computational immunology" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3954> a skos:Concept ;
    skos:prefLabel "Echography" ;
    skos:definition "A diagnostic imaging technique based on the application of ultrasound." ;
    skos:altLabel "Ultrasound imaging" ;
    skos:altLabel "Standardized echography" ;
    skos:altLabel "Ultrasonography" ;
    skos:altLabel "Standard echography" ;
    skos:altLabel "Diagnostic sonography" ;
    skos:altLabel "Medical ultrasound" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3955> a skos:Concept ;
    skos:prefLabel "Fluxomics" ;
    skos:definition "Experimental approaches to determine the rates of metabolic reactions - the metabolic fluxes - within a biological entity." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3957> a skos:Concept ;
    skos:prefLabel "Protein interaction experiment" ;
    skos:definition "An experiment for studying protein-protein interactions." ;
    skos:altLabel "Phage display" ;
    skos:altLabel "Yeast two-hybrid" ;
    skos:altLabel "Yeast one-hybrid" ;
    skos:altLabel "Co-immunoprecipitation" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3958> a skos:Concept ;
    skos:prefLabel "Copy number variation" ;
    skos:definition "A DNA structural variation, specifically a duplication or deletion event, resulting in sections of the genome to be repeated, or the number of repeats in the genome to vary between individuals." ;
    skos:altLabel "CNV deletion" ;
    skos:altLabel "Copy number variant" ;
    skos:altLabel "CNV duplication" ;
    skos:altLabel "Complex CNV" ;
    skos:altLabel "CNV insertion / amplification" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3959> a skos:Concept ;
    skos:prefLabel "Cytogenetics" ;
    skos:definition "The branch of genetics concerned with the relationships between chromosomes and cellular behaviour, especially during mitosis and meiosis." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3966> a skos:Concept ;
    skos:prefLabel "Vaccinology" ;
    skos:definition "The design of vaccines to protect against a particular pathogen, including antigens, delivery systems, and adjuvants to elicit a predictable immune response against specific epitopes." ;
    skos:altLabel "Reverse vaccinology" ;
    skos:altLabel "Structural vaccinology" ;
    skos:altLabel "Rational vaccine design" ;
    skos:altLabel "Vaccine design" ;
    skos:altLabel "Structure-based immunogen design" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3967> a skos:Concept ;
    skos:prefLabel "Immunomics" ;
    skos:definition "The study of immune system as a whole, its regulation and response to pathogens using genome-wide approaches." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3974> a skos:Concept ;
    skos:prefLabel "Epistasis" ;
    skos:definition "The study of the epigenetic modifications of a whole cell, tissue, organism etc." ;
    skos:altLabel "Epistatic interactions" ;
    skos:altLabel "Epistatic genetic interaction" ;
    tar:conceptBranch "topic-edam" .

