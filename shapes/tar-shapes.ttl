# SHACL shapes for write validation (spec §5.3, §7.9), loaded into <urn:tar:shapes>.
#
# These are the normative description of a valid record. The prototype enforces a
# hand-written subset of them on the write path (see src/shacl.rs) because there is no mature
# SHACL engine in Rust yet; the shapes are shipped, queryable and downloadable so that
# shacl-manager — or any SHACL processor — can validate a dump of this registry directly.

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix tar:    <https://w3id.org/tar/ns#> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

tar:SoftwareShape a sh:NodeShape ;
    sh:targetClass schema:SoftwareApplication ;
    sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "Software needs exactly one name" ] ;
    sh:property [ sh:path schema:codeRepository ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:license ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
                  sh:severity sh:Warning ; sh:minCount 1 ;
                  sh:message "FAIR R1.1 asks for a clear licence" ] ;
    sh:property [ sh:path tar:kind ; sh:in ( "service" "library" "cli" "workflow" ) ] ;
    sh:property [ sh:path dct:subject ; sh:nodeKind sh:IRI ] .

tar:CapabilityShape a sh:NodeShape ;
    sh:targetClass tar:Capability ;
    sh:property [ sh:path tar:produces ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path tar:consumes ; sh:nodeKind sh:IRI ] .

tar:InstanceShape a sh:NodeShape ;
    sh:targetClass prov:SoftwareAgent ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "an Instance needs a label" ] ;
    sh:property [ sh:path tar:instanceOf ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "an Instance must name the Software it deploys" ] ;
    sh:property [ sh:path dcat:endpointURL ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path tar:availability ; sh:in ( "public" "restricted" "embargoed" "metadata-only" ) ] ;
    sh:property [ sh:path tar:oidcClientId ; sh:datatype xsd:string ;
                  sh:description "binds a workload identity to this deployment" ] .

tar:ArtifactShape a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "an Artifact needs a title" ] ;
    sh:property [ sh:path dct:conformsTo ; sh:nodeKind sh:IRI ; sh:severity sh:Warning ; sh:minCount 1 ;
                  sh:message "without an ArtifactType this artifact cannot take part in capability matchmaking" ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:isVersionOf ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:distribution ; sh:severity sh:Warning ; sh:minCount 1 ;
                  sh:message "no distribution: the artifact is metadata-only, which must be deliberate" ] .

tar:DistributionShape a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [ sh:path tar:availability ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "public" "restricted" "embargoed" "metadata-only" ) ] ;
    sh:property [ sh:path tar:accessProtocol ; sh:in ( "https" "s3" "sparql" "oci" "ipfs" "file" ) ] ;
    sh:property [ sh:path tar:authMethod ; sh:in ( "none" "apikey" "oauth2" "basic" "signed-url" ) ] ;
    sh:property [ sh:path dcat:byteSize ; sh:datatype xsd:integer ] ;
    # A metadata-only distribution carries no downloadURL at all (spec §6.2).
    sh:not [ sh:and ( [ sh:path tar:availability ; sh:hasValue "metadata-only" ]
                      [ sh:path dcat:downloadURL ; sh:minCount 1 ] ) ] .

tar:RunShape a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:property [ sh:path prov:startedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path prov:endedAtTime ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path tar:status ; sh:in ( "success" "failed" "running" "aborted" ) ] ;
    sh:property [ sh:path tar:atInstance ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "a Run must be attributed to the Instance that performed it" ] .
