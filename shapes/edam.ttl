<http://edamontology.org/topic_3572> a skos:Concept ;
    skos:prefLabel "Data quality management" ;
    skos:definition "The quality, integrity, and cleaning up of data." ;
    skos:altLabel "Data clean-up" ;
    skos:altLabel "Data integrity" ;
