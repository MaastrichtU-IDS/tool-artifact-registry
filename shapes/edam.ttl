    skos:altLabel "Metazoa" ;
    skos:altLabel "Animal" ;
    skos:altLabel "Animals" ;
    skos:altLabel "Animal physiology" ;
    skos:altLabel "Animal genetics" ;
    tar:conceptBranch "topic-edam" .

