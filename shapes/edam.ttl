# edam-version: 1.25.20260626T1230Z
# EDAM topics and data types, bundled so the registry's term pickers work offline.
#
# GENERATED by build.rs from the EDAM release named above — do not edit by hand.
# The data branch types artifacts. The topic branch is kept only so records that already
# cite an EDAM topic still render a label — software topics come from EuroSciVoc now,
# because asked to classify this estate EDAM returned the same two generic topics for
# every tool in it.
#
# ArtifactType is any IRI (spec D11): this bundle makes the common case pickable, it
# does not make EDAM mandatory.

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tar:  <https://w3id.org/tar/ns#> .

<http://edamontology.org/data_0006> a skos:Concept ;
    skos:prefLabel "Data" ;
    skos:definition "Information, represented in an information artefact (data record) that is 'understandable' by dedicated computational tools that can use the data as input or produce it as output." ;
    skos:altLabel "Data record" ;
    skos:altLabel "Data set" ;
    skos:altLabel "Datum" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0582> a skos:Concept ;
    skos:prefLabel "Ontology" ;
    skos:definition "An ontology of biological or bioinformatics concepts and relations, a controlled vocabulary, structured glossary etc." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0842> a skos:Concept ;
    skos:prefLabel "Identifier" ;
    skos:definition "A text token, number or something else which identifies an entity, but which may not be persistent (stable) or unique (the same identifier may identify multiple things)." ;
    skos:altLabel "ID" ;
    skos:altLabel "http://purl.org/dc/elements/1.1/identifier" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0844> a skos:Concept ;
    skos:prefLabel "Molecular mass" ;
    skos:definition "Mass of a molecule." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0845> a skos:Concept ;
    skos:prefLabel "Molecular charge" ;
    skos:definition "Net charge of a molecule." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0846> a skos:Concept ;
    skos:prefLabel "Chemical formula" ;
    skos:definition "A specification of a chemical structure." ;
    skos:altLabel "Chemical structure specification" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0847> a skos:Concept ;
    skos:prefLabel "QSAR descriptor" ;
    skos:definition "A QSAR quantitative descriptor (name-value pair) of chemical structure." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0849> a skos:Concept ;
    skos:prefLabel "Sequence record" ;
    skos:definition "A molecular sequence and associated metadata." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0850> a skos:Concept ;
    skos:prefLabel "Sequence set" ;
    skos:definition "A collection of one or typically multiple molecular sequences (which can include derived data or metadata) that do not (typically) correspond to molecular sequence database records or entries and which (typically) are derived from some analytical method." ;
    skos:altLabel "Alignment reference" ;
    skos:altLabel "SO:0001260" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0856> a skos:Concept ;
    skos:prefLabel "Sequence feature source" ;
    skos:definition "How the annotation of a sequence feature (for example in EMBL or Swiss-Prot) was derived." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0857> a skos:Concept ;
    skos:prefLabel "Sequence search results" ;
    skos:definition "A report of sequence hits and associated data from searching a database of sequences (for example a BLAST search). This will typically include a list of scores (often with statistical evaluation) and a set of alignments for the hits." ;
    skos:altLabel "Sequence database search results" ;
    skos:altLabel "Sequence search hits" ;
    skos:altLabel "Database hits (sequence)" ;
    skos:altLabel "Sequence database hits" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0858> a skos:Concept ;
    skos:prefLabel "Sequence signature matches" ;
    skos:definition "Report on the location of matches (\"hits\") between sequences, sequence profiles, motifs (conserved or functional patterns) and other types of sequence signatures." ;
    skos:altLabel "Sequence profile alignment" ;
    skos:altLabel "Profile-profile alignment" ;
    skos:altLabel "Sequence motif matches" ;
    skos:altLabel "Sequence motif hits" ;
    skos:altLabel "Protein secondary database search results" ;
    skos:altLabel "Sequence-profile alignment" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0860> a skos:Concept ;
    skos:prefLabel "Sequence signature data" ;
    skos:definition "Data concering concerning specific or conserved pattern in molecular sequences and the classifiers used for their identification, including sequence motifs, profiles or other diagnostic element." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0862> a skos:Concept ;
    skos:prefLabel "Dotplot" ;
    skos:definition "A dotplot of sequence similarities identified from word-matching or character comparison." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0863> a skos:Concept ;
    skos:prefLabel "Sequence alignment" ;
    skos:definition "Alignment of multiple molecular sequences." ;
    skos:altLabel "Multiple sequence aligment" ;
    skos:altLabel "msa" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0865> a skos:Concept ;
    skos:prefLabel "Sequence similarity score" ;
    skos:definition "A value representing molecular sequence similarity." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0867> a skos:Concept ;
    skos:prefLabel "Sequence alignment report" ;
    skos:definition "An informative report of molecular sequence alignment-derived data or metadata." ;
    skos:altLabel "Sequence alignment metadata" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0870> a skos:Concept ;
    skos:prefLabel "Sequence distance matrix" ;
    skos:definition "A matrix of estimated evolutionary distance between molecular sequences, such as is suitable for phylogenetic tree calculation." ;
    skos:altLabel "Phylogenetic distance matrix" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0871> a skos:Concept ;
    skos:prefLabel "Phylogenetic character data" ;
    skos:definition "Basic character data from which a phylogenetic tree may be generated." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0872> a skos:Concept ;
    skos:prefLabel "Phylogenetic tree" ;
    skos:definition "The raw data (not just an image) from which a phylogenetic tree is directly generated or plotted, such as topology, lengths (in time or in expected amounts of variance) and a confidence interval for each length." ;
    skos:altLabel "Phylogeny" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0874> a skos:Concept ;
    skos:prefLabel "Comparison matrix" ;
    skos:definition "Matrix of integer or floating point numbers for amino acid or nucleotide sequence comparison." ;
    skos:altLabel "Substitution matrix" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0878> a skos:Concept ;
    skos:prefLabel "Protein secondary structure alignment" ;
    skos:definition "Alignment of the (1D representations of) secondary structure of two or more proteins." ;
    skos:altLabel "Secondary structure alignment (protein)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0880> a skos:Concept ;
    skos:prefLabel "RNA secondary structure" ;
    skos:definition "An informative report of secondary structure (predicted or real) of an RNA molecule." ;
    skos:altLabel "Secondary structure (RNA)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0881> a skos:Concept ;
    skos:prefLabel "RNA secondary structure alignment" ;
    skos:definition "Alignment of the (1D representations of) secondary structure of two or more RNA molecules." ;
    skos:altLabel "Secondary structure alignment (RNA)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0883> a skos:Concept ;
    skos:prefLabel "Structure" ;
    skos:definition "3D coordinate and associated data for a macromolecular tertiary (3D) structure or part of a structure." ;
    skos:altLabel "Coordinate model" ;
    skos:altLabel "Structure data" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0886> a skos:Concept ;
    skos:prefLabel "Structure alignment" ;
    skos:definition "Alignment (superimposition) of molecular tertiary (3D) structures." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0887> a skos:Concept ;
    skos:prefLabel "Structure alignment report" ;
    skos:definition "An informative report of molecular tertiary structure alignment-derived data." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0888> a skos:Concept ;
    skos:prefLabel "Structure similarity score" ;
    skos:definition "A value representing molecular structure similarity, measured from structure alignment or some other type of structure comparison." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0889> a skos:Concept ;
    skos:prefLabel "Structural profile" ;
    skos:definition "Some type of structural (3D) profile or template (representing a structure or structure alignment)." ;
    skos:altLabel "3D profile" ;
    skos:altLabel "Structural (3D) profile" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0890> a skos:Concept ;
    skos:prefLabel "Structural (3D) profile alignment" ;
    skos:definition "A 3D profile-3D profile alignment (each profile representing structures or a structure alignment)." ;
    skos:altLabel "Structural profile alignment" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0892> a skos:Concept ;
    skos:prefLabel "Protein sequence-structure scoring matrix" ;
    skos:definition "Matrix of values used for scoring sequence-structure compatibility." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0893> a skos:Concept ;
    skos:prefLabel "Sequence-structure alignment" ;
    skos:definition "An alignment of molecular sequence to structure (from threading sequence(s) through 3D structure or representation of structure(s))." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0896> a skos:Concept ;
    skos:prefLabel "Protein report" ;
    skos:definition "An informative human-readable report about one or more specific protein molecules or protein structural domains, derived from analysis of primary (sequence or structural) data." ;
    skos:altLabel "Gene product annotation" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0897> a skos:Concept ;
    skos:prefLabel "Protein property" ;
    skos:definition "A report of primarily non-positional data describing intrinsic physical, chemical or other properties of a protein molecule or model." ;
    skos:altLabel "Protein physicochemical property" ;
    skos:altLabel "Protein properties" ;
    skos:altLabel "Protein sequence statistics" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0905> a skos:Concept ;
    skos:prefLabel "Protein interaction raw data" ;
    skos:definition "Protein-protein interaction data from for example yeast two-hybrid analysis, protein microarrays, immunoaffinity chromatography followed by mass spectrometry, phage display etc." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0906> a skos:Concept ;
    skos:prefLabel "Protein interaction data" ;
    skos:definition "Data concerning the interactions (predicted or known) within or between a protein, structural domain or part of a protein. This includes intra- and inter-residue contacts and distances, as well as interactions with other proteins and non-protein entities such as nucleic acid, metal atoms, water, ions etc." ;
    skos:altLabel "Protein interaction record" ;
    skos:altLabel "Protein-protein interaction data" ;
    skos:altLabel "Protein interaction report" ;
    skos:altLabel "Protein report (interaction)" ;
    skos:altLabel "Protein non-covalent interactions report" ;
    skos:altLabel "Atom interaction data" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0907> a skos:Concept ;
    skos:prefLabel "Protein family report" ;
    skos:definition "An informative report on a specific protein family or other classification or group of protein sequences or structures." ;
    skos:altLabel "Protein classification data" ;
    skos:altLabel "Protein family annotation" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0909> a skos:Concept ;
    skos:prefLabel "Vmax" ;
    skos:definition "The maximum initial velocity or rate of a reaction. It is the limiting velocity as substrate concentrations get very large." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0910> a skos:Concept ;
    skos:prefLabel "Km" ;
    skos:definition "Km is the concentration (usually in Molar units) of substrate that leads to half-maximal velocity of an enzyme-catalysed reaction." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0912> a skos:Concept ;
    skos:prefLabel "Nucleic acid property" ;
    skos:definition "A report of primarily non-positional data describing intrinsic physical, chemical or other properties of a nucleic acid molecule." ;
    skos:altLabel "Nucleic acid physicochemical property" ;
    skos:altLabel "Nucleic acid structural property" ;
    skos:altLabel "Nucleic acid property (structural)" ;
    skos:altLabel "GC-content" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0914> a skos:Concept ;
    skos:prefLabel "Codon usage data" ;
    skos:definition "Data derived from analysis of codon usage (typically a codon usage table) of DNA sequences." ;
    skos:altLabel "Codon usage report" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0916> a skos:Concept ;
    skos:prefLabel "Gene report" ;
    skos:definition "A report on predicted or actual gene structure, regions which make an RNA product and features such as promoters, coding regions, splice sites etc." ;
    skos:altLabel "Gene annotation" ;
    skos:altLabel "Gene and transcript structure (report)" ;
    skos:altLabel "Gene function (report)" ;
    skos:altLabel "Gene structure (repot)" ;
    skos:altLabel "Nucleic acid features (gene and transcript structure)" ;
    skos:altLabel "Gene features report" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0919> a skos:Concept ;
    skos:prefLabel "Chromosome report" ;
    skos:definition "A human-readable collection of information about a specific chromosome." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0920> a skos:Concept ;
    skos:prefLabel "Genotype/phenotype report" ;
    skos:definition "A human-readable collection of information about the set of genes (or allelic forms) present in an individual, organism or cell and associated with a specific physical characteristic, or a report concerning an organisms traits and phenotypes." ;
    skos:altLabel "Genotype/phenotype annotation" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0924> a skos:Concept ;
    skos:prefLabel "Sequence trace" ;
    skos:definition "Fluorescence trace data generated by an automated DNA sequencer, which can be interprted as a molecular sequence (reads), given associated sequencing metadata such as base-call quality scores." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0925> a skos:Concept ;
    skos:prefLabel "Sequence assembly" ;
    skos:definition "An assembly of fragments of a (typically genomic) DNA sequence." ;
    skos:altLabel "Contigs" ;
    skos:altLabel "SO:0000353" ;
    skos:altLabel "SO:0001248" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0926> a skos:Concept ;
    skos:prefLabel "RH scores" ;
    skos:definition "Radiation hybrid scores (RH) scores for one or more markers." ;
    skos:altLabel "Radiation Hybrid (RH) scores" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0927> a skos:Concept ;
    skos:prefLabel "Genetic linkage report" ;
    skos:definition "A human-readable collection of information about the linkage of alleles." ;
    skos:altLabel "Gene annotation (linkage)" ;
    skos:altLabel "Linkage disequilibrium (report)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0928> a skos:Concept ;
    skos:prefLabel "Gene expression profile" ;
    skos:definition "Data quantifying the level of expression of (typically) multiple genes, derived for example from microarray experiments." ;
    skos:altLabel "Gene expression pattern" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0937> a skos:Concept ;
    skos:prefLabel "Electron density map" ;
    skos:definition "X-ray crystallography data." ;
    skos:altLabel "Protein X-ray crystallographic data" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0938> a skos:Concept ;
    skos:prefLabel "Raw NMR data" ;
    skos:definition "Nuclear magnetic resonance (NMR) raw data, typically for a protein." ;
    skos:altLabel "Protein NMR data" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0939> a skos:Concept ;
    skos:prefLabel "CD spectra" ;
    skos:definition "Protein secondary structure from protein coordinate or circular dichroism (CD) spectroscopic data." ;
    skos:altLabel "Protein circular dichroism (CD) spectroscopic data" ;
    skos:altLabel "CD spectrum" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0940> a skos:Concept ;
    skos:prefLabel "Volume map" ;
    skos:definition "Volume map data from electron microscopy." ;
    skos:altLabel "3D volume map" ;
    skos:altLabel "EM volume map" ;
    skos:altLabel "Electron microscopy volume map" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0942> a skos:Concept ;
    skos:prefLabel "2D PAGE image" ;
    skos:definition "Two-dimensional gel electrophoresis image" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0943> a skos:Concept ;
    skos:prefLabel "Mass spectrum" ;
    skos:definition "Spectra from mass spectrometry." ;
    skos:altLabel "Mass spectrometry spectra" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0944> a skos:Concept ;
    skos:prefLabel "Peptide mass fingerprint" ;
    skos:definition "A set of peptide masses (peptide mass fingerprint) from mass spectrometry." ;
    skos:altLabel "Protein fingerprint" ;
    skos:altLabel "Peak list" ;
    skos:altLabel "Molecular weights standard fingerprint" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0945> a skos:Concept ;
    skos:prefLabel "Peptide identification" ;
    skos:definition "Protein or peptide identifications with evidence supporting the identifications, for example from comparing a peptide mass fingerprint (from mass spectrometry) to a sequence database, or  the set of typical spectra one obtains when running a protein through a mass spectrometer." ;
    skos:altLabel "Peptide spectrum match" ;
    skos:altLabel "'Protein identification'" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0949> a skos:Concept ;
    skos:prefLabel "Workflow metadata" ;
    skos:definition "Basic information, annotation or documentation concerning a workflow (but not the workflow itself)." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0950> a skos:Concept ;
    skos:prefLabel "Mathematical model" ;
    skos:definition "A biological model represented in mathematical terms." ;
    skos:altLabel "Biological model" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0951> a skos:Concept ;
    skos:prefLabel "Statistical estimate score" ;
    skos:definition "A value representing estimated statistical significance of some observed data; typically sequence database hits." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0954> a skos:Concept ;
    skos:prefLabel "Database cross-mapping" ;
    skos:definition "A mapping of the accession numbers (or other database identifier) of entries between (typically) two biological or biomedical databases." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0955> a skos:Concept ;
    skos:prefLabel "Data index" ;
    skos:definition "An index of data of biological relevance." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0956> a skos:Concept ;
    skos:prefLabel "Data index report" ;
    skos:definition "A human-readable collection of information concerning an analysis of an index of biological data." ;
    skos:altLabel "Database index annotation" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0957> a skos:Concept ;
    skos:prefLabel "Database metadata" ;
    skos:definition "Basic information on bioinformatics database(s) or other data sources such as name, type, description, URL etc." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0958> a skos:Concept ;
    skos:prefLabel "Tool metadata" ;
    skos:definition "Basic information about one or more bioinformatics applications or packages, such as name, type, description, or other documentation." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0960> a skos:Concept ;
    skos:prefLabel "User metadata" ;
    skos:definition "Textual metadata on a software author or end-user, for example a person or other software." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0962> a skos:Concept ;
    skos:prefLabel "Small molecule report" ;
    skos:definition "A human-readable collection of information about a specific chemical compound." ;
    skos:altLabel "Small molecule annotation" ;
    skos:altLabel "Chemical structure report" ;
    skos:altLabel "Chemical compound annotation" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0963> a skos:Concept ;
    skos:prefLabel "Cell line report" ;
    skos:definition "A human-readable collection of information about a particular strain of organism cell line including plants, virus, fungi and bacteria. The data typically includes strain number, organism type, growth conditions, source and so on." ;
    skos:altLabel "Cell line annotation" ;
    skos:altLabel "Organism strain data" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0966> a skos:Concept ;
    skos:prefLabel "Ontology term" ;
    skos:definition "A term (name) from an ontology." ;
    skos:altLabel "Ontology class name" ;
    skos:altLabel "Ontology terms" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0967> a skos:Concept ;
    skos:prefLabel "Ontology concept data" ;
    skos:definition "Data concerning or derived from a concept from a biological ontology." ;
    skos:altLabel "Ontology class metadata" ;
    skos:altLabel "Ontology term metadata" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0968> a skos:Concept ;
    skos:prefLabel "Keyword" ;
    skos:definition "Keyword(s) or phrase(s) used (typically) for text-searching purposes." ;
    skos:altLabel "Phrases" ;
    skos:altLabel "Term" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0970> a skos:Concept ;
    skos:prefLabel "Citation" ;
    skos:definition "Bibliographic data that uniquely identifies a scientific article, book or other published material." ;
    skos:altLabel "Bibliographic reference" ;
    skos:altLabel "Reference" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0971> a skos:Concept ;
    skos:prefLabel "Article" ;
    skos:definition "A scientific text, typically a full text article from a scientific journal." ;
    skos:altLabel "Article text" ;
    skos:altLabel "Scientific article" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0972> a skos:Concept ;
    skos:prefLabel "Text mining report" ;
    skos:definition "A human-readable collection of information resulting from text mining." ;
    skos:altLabel "Text mining output" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0976> a skos:Concept ;
    skos:prefLabel "Identifier (by type of data)" ;
    skos:definition "An identifier that identifies a particular type of data." ;
    skos:altLabel "Identifier (typed)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0977> a skos:Concept ;
    skos:prefLabel "Tool identifier" ;
    skos:definition "An identifier of a bioinformatics tool, e.g. an application or web service." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0982> a skos:Concept ;
    skos:prefLabel "Molecule identifier" ;
    skos:definition "Name or other identifier of a molecule." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0983> a skos:Concept ;
    skos:prefLabel "Atom ID" ;
    skos:definition "Identifier (e.g. character symbol) of a specific atom." ;
    skos:altLabel "Atom identifier" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0984> a skos:Concept ;
    skos:prefLabel "Molecule name" ;
    skos:definition "Name of a specific molecule." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0987> a skos:Concept ;
    skos:prefLabel "Chromosome name" ;
    skos:definition "Name of a chromosome." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0988> a skos:Concept ;
    skos:prefLabel "Peptide identifier" ;
    skos:definition "Identifier of a peptide chain." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0989> a skos:Concept ;
    skos:prefLabel "Protein identifier" ;
    skos:definition "Identifier of a protein." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_0990> a skos:Concept ;
    skos:prefLabel "Compound name" ;
    skos:definition "Unique name of a chemical compound." ;
    skos:altLabel "Chemical name" ;
    tar:conceptBranch "data" .

