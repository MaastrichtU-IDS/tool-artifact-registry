<http://edamontology.org/data_2024> a skos:Concept ;
    skos:prefLabel "Enzyme kinetics data" ;
    skos:definition "Data concerning chemical reaction(s) catalysed by enzyme(s)." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2025> a skos:Concept ;
    skos:prefLabel "Michaelis Menten plot" ;
    skos:definition "A plot giving an approximation of the kinetics of an enzyme-catalysed reaction, assuming simple kinetics (i.e. no intermediate or product inhibition, allostericity or cooperativity). It plots initial reaction rate to the substrate concentration (S) from which the maximum rate (vmax) is apparent." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2026> a skos:Concept ;
    skos:prefLabel "Hanes Woolf plot" ;
    skos:definition "A plot based on the Michaelis Menten equation of enzyme kinetics plotting the ratio of the initial substrate concentration (S) against the reaction velocity (v)." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2042> a skos:Concept ;
    skos:prefLabel "Evidence" ;
    skos:definition "Typically a human-readable summary of body of facts or information indicating why a statement is true or valid. This may include a computational prediction, laboratory experiment, literature reference etc." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2044> a skos:Concept ;
    skos:prefLabel "Sequence" ;
    skos:definition "One or more molecular sequences, possibly with associated annotation." ;
    skos:altLabel "Sequences" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2048> a skos:Concept ;
    skos:prefLabel "Report" ;
    skos:definition "A human-readable collection of information including annotation on a biological entity or phenomena, computer-generated reports of analysis of primary data (e.g. sequence or structural), and metadata (data about primary data) or any other free (essentially unformatted) text, as distinct from the primary data itself." ;
    skos:altLabel "Document" ;
    skos:altLabel "Record" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2050> a skos:Concept ;
    skos:prefLabel "Molecular property (general)" ;
    skos:definition "General data for a molecule." ;
    skos:altLabel "General molecular property" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2070> a skos:Concept ;
    skos:prefLabel "Sequence motif (nucleic acid)" ;
    skos:definition "A nucleotide sequence motif." ;
    skos:altLabel "Nucleic acid sequence motif" ;
    skos:altLabel "RNA sequence motif" ;
    skos:altLabel "DNA sequence motif" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2071> a skos:Concept ;
    skos:prefLabel "Sequence motif (protein)" ;
    skos:definition "An amino acid sequence motif." ;
    skos:altLabel "Protein sequence motif" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2080> a skos:Concept ;
    skos:prefLabel "Database search results" ;
    skos:definition "A report of hits from searching a database of some type." ;
    skos:altLabel "Database hits" ;
    skos:altLabel "Search results" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2082> a skos:Concept ;
    skos:prefLabel "Matrix" ;
    skos:definition "An array of numerical values." ;
    skos:altLabel "Array" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2084> a skos:Concept ;
    skos:prefLabel "Nucleic acid report" ;
    skos:definition "A human-readable collection of information about one or more specific nucleic acid molecules." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2085> a skos:Concept ;
    skos:prefLabel "Structure report" ;
    skos:definition "A human-readable collection of information about one or more molecular tertiary (3D) structures.  It might include annotation on the structure, a computer-generated report of analysis of structural data, and metadata (data about primary data) or any other free (essentially unformatted) text, as distinct from the primary data itself." ;
    skos:altLabel "Structure-derived report" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2087> a skos:Concept ;
    skos:prefLabel "Molecular property" ;
    skos:definition "A report on the physical (e.g. structural) or chemical properties of molecules, or parts of a molecule." ;
    skos:altLabel "Physicochemical property" ;
    skos:altLabel "SO:0000400" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2088> a skos:Concept ;
    skos:prefLabel "DNA base structural data" ;
    skos:definition "Structural data for DNA base pairs or runs of bases, such as energy or angle data." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2091> a skos:Concept ;
    skos:prefLabel "Accession" ;
    skos:definition "A persistent (stable) and unique identifier, typically identifying an object (entry) from a database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2093> a skos:Concept ;
    skos:prefLabel "Data reference" ;
    skos:definition "Reference to a dataset (or a cross-reference between two datasets), typically one or more entries in a biological database or ontology." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2098> a skos:Concept ;
    skos:prefLabel "Job identifier" ;
    skos:definition "An identifier of a submitted job." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2099> a skos:Concept ;
    skos:prefLabel "Name" ;
    skos:definition "A name of a thing, which need not necessarily uniquely identify it." ;
    skos:altLabel "http://www.w3.org/2000/01/rdf-schema#label" ;
    skos:altLabel "Symbolic name" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2101> a skos:Concept ;
    skos:prefLabel "User ID" ;
    skos:definition "An identifier of a software end-user (typically a person)." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2102> a skos:Concept ;
    skos:prefLabel "KEGG organism code" ;
    skos:definition "A three-letter code used in the KEGG databases to uniquely identify organisms." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2104> a skos:Concept ;
    skos:prefLabel "BioCyc ID" ;
    skos:definition "Identifier of an object from one of the BioCyc databases." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2105> a skos:Concept ;
    skos:prefLabel "Compound ID (BioCyc)" ;
    skos:definition "Identifier of a compound from the BioCyc chemical compounds database." ;
    skos:altLabel "BioCyc compound identifier" ;
    skos:altLabel "BioCyc compound ID" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2106> a skos:Concept ;
    skos:prefLabel "Reaction ID (BioCyc)" ;
    skos:definition "Identifier of a biological reaction from the BioCyc reactions database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2107> a skos:Concept ;
    skos:prefLabel "Enzyme ID (BioCyc)" ;
    skos:definition "Identifier of an enzyme from the BioCyc enzymes database." ;
    skos:altLabel "BioCyc enzyme ID" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2108> a skos:Concept ;
    skos:prefLabel "Reaction ID" ;
    skos:definition "Identifier of a biological reaction from a database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2109> a skos:Concept ;
    skos:prefLabel "Identifier (hybrid)" ;
    skos:definition "An identifier that is re-used for data objects of fundamentally different types (typically served from a single database)." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2110> a skos:Concept ;
    skos:prefLabel "Molecular property identifier" ;
    skos:definition "Identifier of a molecular property." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2111> a skos:Concept ;
    skos:prefLabel "Codon usage table ID" ;
    skos:definition "Identifier of a codon usage table, for example a genetic code." ;
    skos:altLabel "Codon usage table identifier" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2112> a skos:Concept ;
    skos:prefLabel "FlyBase primary identifier" ;
    skos:definition "Primary identifier of an object from the FlyBase database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2113> a skos:Concept ;
    skos:prefLabel "WormBase identifier" ;
    skos:definition "Identifier of an object from the WormBase database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2114> a skos:Concept ;
    skos:prefLabel "WormBase wormpep ID" ;
    skos:definition "Protein identifier used by WormBase database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2117> a skos:Concept ;
    skos:prefLabel "Map identifier" ;
    skos:definition "An identifier of a map of a molecular sequence." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2118> a skos:Concept ;
    skos:prefLabel "Person identifier" ;
    skos:definition "An identifier of a software end-user (typically a person)." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2119> a skos:Concept ;
    skos:prefLabel "Nucleic acid identifier" ;
    skos:definition "Name or other identifier of a nucleic acid molecule." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2127> a skos:Concept ;
    skos:prefLabel "Genetic code identifier" ;
    skos:definition "An identifier of a genetic code." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2128> a skos:Concept ;
    skos:prefLabel "Genetic code name" ;
    skos:definition "Informal name for a genetic code, typically an organism name." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2129> a skos:Concept ;
    skos:prefLabel "File format name" ;
    skos:definition "Name of a file format such as HTML, PNG, PDF, EMBL, GenBank and so on." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2131> a skos:Concept ;
    skos:prefLabel "Operating system name" ;
    skos:definition "Name of a computer operating system such as Linux, PC or Mac." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2133> a skos:Concept ;
    skos:prefLabel "Logical operator" ;
    skos:definition "A logical operator such as OR, AND, XOR, and NOT." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2137> a skos:Concept ;
    skos:prefLabel "Gap penalty" ;
    skos:definition "A penalty for introducing or extending a gap in an alignment." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2139> a skos:Concept ;
    skos:prefLabel "Nucleic acid melting temperature" ;
    skos:definition "A temperature concerning nucleic acid denaturation, typically the temperature at which the two strands of a hybridised or double stranded nucleic acid (DNA or RNA/DNA) molecule separate." ;
    skos:altLabel "Melting temperature" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2140> a skos:Concept ;
    skos:prefLabel "Concentration" ;
    skos:definition "The concentration of a chemical compound." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2154> a skos:Concept ;
    skos:prefLabel "Sequence name" ;
    skos:definition "Any arbitrary name of a molecular sequence." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2160> a skos:Concept ;
    skos:prefLabel "Fickett testcode plot" ;
    skos:definition "A plot of Fickett testcode statistic (identifying protein coding regions) in a nucleotide sequences." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2161> a skos:Concept ;
    skos:prefLabel "Sequence similarity plot" ;
    skos:definition "A plot of sequence similarities identified from word-matching or character comparison." ;
    skos:altLabel "Sequence conservation report" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2162> a skos:Concept ;
    skos:prefLabel "Helical wheel" ;
    skos:definition "An image of peptide sequence sequence looking down the axis of the helix for highlighting amphipathicity and other properties." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2163> a skos:Concept ;
    skos:prefLabel "Helical net" ;
    skos:definition "An image of peptide sequence sequence in a simple 3,4,3,4 repeating pattern that emulates at a simple level the arrangement of residues around an alpha helix." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2165> a skos:Concept ;
    skos:prefLabel "Protein ionisation curve" ;
    skos:definition "A plot of pK versus pH for a protein." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2166> a skos:Concept ;
    skos:prefLabel "Sequence composition plot" ;
    skos:definition "A plot of character or word composition / frequency of a molecular sequence." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2167> a skos:Concept ;
    skos:prefLabel "Nucleic acid density plot" ;
    skos:definition "Density plot (of base composition) for a nucleotide sequence." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2168> a skos:Concept ;
    skos:prefLabel "Sequence trace image" ;
    skos:definition "Image of a sequence trace (nucleotide sequence versus probabilities of each of the 4 bases)." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2174> a skos:Concept ;
    skos:prefLabel "FlyBase secondary identifier" ;
    skos:definition "Secondary identifier of an object from the FlyBase database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2190> a skos:Concept ;
    skos:prefLabel "Sequence checksum" ;
    skos:definition "A fixed-size datum calculated (by using a hash function) for a molecular sequence, typically for purposes of error detection or indexing." ;
    skos:altLabel "Hash code" ;
    skos:altLabel "Hash value" ;
    skos:altLabel "Hash" ;
    skos:altLabel "Hash sum" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2193> a skos:Concept ;
    skos:prefLabel "Database entry metadata" ;
    skos:definition "Basic information on any arbitrary database entry." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2208> a skos:Concept ;
    skos:prefLabel "Plasmid identifier" ;
    skos:definition "An identifier of a plasmid in a database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2209> a skos:Concept ;
    skos:prefLabel "Mutation ID" ;
    skos:definition "A unique identifier of a specific mutation catalogued in a database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2216> a skos:Concept ;
    skos:prefLabel "Codon number" ;
    skos:definition "The number of a codon, for instance, at which a mutation is located." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2219> a skos:Concept ;
    skos:prefLabel "Database field name" ;
    skos:definition "The name of a field in a database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2220> a skos:Concept ;
    skos:prefLabel "Sequence cluster ID (SYSTERS)" ;
    skos:definition "Unique identifier of a sequence cluster from the SYSTERS database." ;
    skos:altLabel "SYSTERS cluster ID" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2223> a skos:Concept ;
    skos:prefLabel "Ontology metadata" ;
    skos:definition "Data concerning a biological ontology." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2253> a skos:Concept ;
    skos:prefLabel "Data resource definition name" ;
    skos:definition "The name of a data type." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2254> a skos:Concept ;
    skos:prefLabel "OBO file format name" ;
    skos:definition "Name of an OBO file format such as OBO-XML, plain and so on." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2285> a skos:Concept ;
    skos:prefLabel "Gene ID (MIPS)" ;
    skos:definition "Identifier for genetic elements in MIPS database." ;
    skos:altLabel "MIPS genetic element identifier" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2290> a skos:Concept ;
    skos:prefLabel "EMBL accession" ;
    skos:definition "An accession number of an entry from the EMBL sequence database." ;
    skos:altLabel "EMBL accession number" ;
    skos:altLabel "EMBL identifier" ;
    skos:altLabel "EMBL ID" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2291> a skos:Concept ;
    skos:prefLabel "UniProt ID" ;
    skos:definition "An identifier of a polypeptide in the UniProt database." ;
    skos:altLabel "UniProtKB identifier" ;
    skos:altLabel "UniProt entry name" ;
    skos:altLabel "UniProtKB entry name" ;
    skos:altLabel "UniProt identifier" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2292> a skos:Concept ;
    skos:prefLabel "GenBank accession" ;
    skos:definition "Accession number of an entry from the GenBank sequence database." ;
    skos:altLabel "GenBank accession number" ;
    skos:altLabel "GenBank identifier" ;
    skos:altLabel "GenBank ID" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2293> a skos:Concept ;
    skos:prefLabel "Gramene secondary identifier" ;
    skos:definition "Secondary (internal) identifier of a Gramene database entry." ;
    skos:altLabel "Gramene internal ID" ;
    skos:altLabel "Gramene internal identifier" ;
    skos:altLabel "Gramene secondary ID" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2294> a skos:Concept ;
    skos:prefLabel "Sequence variation ID" ;
    skos:definition "An identifier of an entry from a database of molecular sequence variation." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2295> a skos:Concept ;
    skos:prefLabel "Gene ID" ;
    skos:definition "A unique (and typically persistent) identifier of a gene in a database, that is (typically) different to the gene name/symbol." ;
    skos:altLabel "Gene accession" ;
    skos:altLabel "Gene code" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2297> a skos:Concept ;
    skos:prefLabel "Gene ID (ECK)" ;
    skos:definition "Identifier of an E. coli K-12 gene from EcoGene Database." ;
    skos:altLabel "E. coli K-12 gene identifier" ;
    skos:altLabel "ECK accession" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2298> a skos:Concept ;
    skos:prefLabel "Gene ID (HGNC)" ;
    skos:definition "Identifier for a gene approved by the HUGO Gene Nomenclature Committee." ;
    skos:altLabel "HGNC ID" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2299> a skos:Concept ;
    skos:prefLabel "Gene name" ;
    skos:definition "The name of a gene, (typically) assigned by a person and/or according to a naming scheme. It may contain white space characters and is typically more intuitive and readable than a gene symbol. It (typically) may be used to identify similar genes in different species and to derive a gene symbol." ;
    skos:altLabel "Allele name" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2301> a skos:Concept ;
    skos:prefLabel "SMILES string" ;
    skos:definition "A specification of a chemical structure in SMILES format." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2302> a skos:Concept ;
    skos:prefLabel "STRING ID" ;
    skos:definition "Unique identifier of an entry from the STRING database of protein-protein interactions." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2309> a skos:Concept ;
    skos:prefLabel "Reaction ID (SABIO-RK)" ;
    skos:definition "Identifier of a biological reaction from the SABIO-RK reactions database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2313> a skos:Concept ;
    skos:prefLabel "Carbohydrate report" ;
    skos:definition "A human-readable collection of information about one or more specific carbohydrate 3D structure(s)." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2314> a skos:Concept ;
    skos:prefLabel "GI number" ;
    skos:definition "A series of digits that are assigned consecutively to each sequence record processed by NCBI. The GI number bears no resemblance to the Accession number of the sequence record." ;
    skos:altLabel "NCBI GI number" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2315> a skos:Concept ;
    skos:prefLabel "NCBI version" ;
    skos:definition "An identifier assigned to sequence records processed by NCBI, made of the accession number of the database record followed by a dot and a version number." ;
    skos:altLabel "NCBI accession.version" ;
    skos:altLabel "accession.version" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2316> a skos:Concept ;
    skos:prefLabel "Cell line name" ;
    skos:definition "The name of a cell line." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2317> a skos:Concept ;
    skos:prefLabel "Cell line name (exact)" ;
    skos:definition "The name of a cell line." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2318> a skos:Concept ;
    skos:prefLabel "Cell line name (truncated)" ;
    skos:definition "The name of a cell line." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2319> a skos:Concept ;
    skos:prefLabel "Cell line name (no punctuation)" ;
    skos:definition "The name of a cell line." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2320> a skos:Concept ;
    skos:prefLabel "Cell line name (assonant)" ;
    skos:definition "The name of a cell line." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2321> a skos:Concept ;
    skos:prefLabel "Enzyme ID" ;
    skos:definition "A unique, persistent identifier of an enzyme." ;
    skos:altLabel "Enzyme accession" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2325> a skos:Concept ;
    skos:prefLabel "REBASE enzyme number" ;
    skos:definition "Identifier of an enzyme from the REBASE enzymes database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2326> a skos:Concept ;
    skos:prefLabel "DrugBank ID" ;
    skos:definition "Unique identifier of a drug from the DrugBank database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2327> a skos:Concept ;
    skos:prefLabel "GI number (protein)" ;
    skos:definition "A unique identifier assigned to NCBI protein sequence records." ;
    skos:altLabel "protein gi" ;
    skos:altLabel "protein gi number" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2335> a skos:Concept ;
    skos:prefLabel "Bit score" ;
    skos:definition "A score derived from the alignment of two sequences, which is then normalised with respect to the scoring system." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2337> a skos:Concept ;
    skos:prefLabel "Resource metadata" ;
    skos:definition "Data concerning or describing some core computational resource, as distinct from primary data.  This includes metadata on the origin, source, history, ownership or location of some thing." ;
    skos:altLabel "Provenance metadata" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2338> a skos:Concept ;
    skos:prefLabel "Ontology identifier" ;
    skos:definition "Any arbitrary identifier of an ontology." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2339> a skos:Concept ;
    skos:prefLabel "Ontology concept name" ;
    skos:definition "The name of a concept in an ontology." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2340> a skos:Concept ;
    skos:prefLabel "Genome build identifier" ;
    skos:definition "An identifier of a build of a particular genome." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2342> a skos:Concept ;
    skos:prefLabel "Pathway or network name" ;
    skos:definition "The name of a biological pathway or network." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2343> a skos:Concept ;
    skos:prefLabel "Pathway ID (KEGG)" ;
    skos:definition "Identifier of a pathway from the KEGG pathway database." ;
    skos:altLabel "KEGG pathway ID" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2344> a skos:Concept ;
    skos:prefLabel "Pathway ID (NCI-Nature)" ;
    skos:definition "Identifier of a pathway from the NCI-Nature pathway database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_2345> a skos:Concept ;
