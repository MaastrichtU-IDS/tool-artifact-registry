    skos:altLabel "Sequence composition (amino acid words)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1270> a skos:Concept ;
    skos:prefLabel "Feature table" ;
    skos:definition "Annotation of positional sequence features, organised into a standard feature table." ;
    skos:altLabel "Sequence feature table" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1274> a skos:Concept ;
    skos:prefLabel "Map" ;
    skos:definition "A map of (typically one) DNA sequence annotated with positional or non-positional features." ;
    skos:altLabel "DNA map" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1276> a skos:Concept ;
    skos:prefLabel "Nucleic acid features" ;
    skos:definition "An informative report on intrinsic positional features of a nucleotide sequence, formatted to be machine-readable." ;
    skos:altLabel "Nucleic acid feature table" ;
    skos:altLabel "Feature table (nucleic acid)" ;
    skos:altLabel "Genome features" ;
    skos:altLabel "Genomic features" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1277> a skos:Concept ;
    skos:prefLabel "Protein features" ;
    skos:definition "An informative report on intrinsic positional features of a protein sequence." ;
    skos:altLabel "Protein feature table" ;
    skos:altLabel "Feature table (protein)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1278> a skos:Concept ;
    skos:prefLabel "Genetic map" ;
    skos:definition "A map showing the relative positions of genetic markers in a nucleic acid sequence, based on estimation of non-physical distance such as recombination frequencies." ;
    skos:altLabel "Linkage map" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1279> a skos:Concept ;
    skos:prefLabel "Sequence map" ;
    skos:definition "A map of genetic markers in a contiguous, assembled genomic sequence, with the sizes and separation of markers measured in base pairs." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1280> a skos:Concept ;
    skos:prefLabel "Physical map" ;
    skos:definition "A map of DNA (linear or circular) annotated with physical features or landmarks such as restriction sites, cloned DNA fragments, genes or genetic markers, along with the physical distances between them." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1283> a skos:Concept ;
    skos:prefLabel "Cytogenetic map" ;
    skos:definition "A map showing banding patterns derived from direct observation of a stained chromosome." ;
    skos:altLabel "Cytogenic map" ;
    skos:altLabel "Chromosome map" ;
    skos:altLabel "Cytologic map" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1284> a skos:Concept ;
    skos:prefLabel "DNA transduction map" ;
    skos:definition "A gene map showing distances between loci based on relative cotransduction frequencies." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1285> a skos:Concept ;
    skos:prefLabel "Gene map" ;
    skos:definition "Sequence map of a single gene annotated with genetic features such as introns, exons, untranslated regions, polyA signals, promoters, enhancers and (possibly) mutations defining alleles of a gene." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1286> a skos:Concept ;
    skos:prefLabel "Plasmid map" ;
    skos:definition "Sequence map of a plasmid (circular DNA)." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1288> a skos:Concept ;
    skos:prefLabel "Genome map" ;
    skos:definition "Sequence map of a whole genome." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1289> a skos:Concept ;
    skos:prefLabel "Restriction map" ;
    skos:definition "Image of the restriction enzyme cleavage sites (restriction sites) in a nucleic acid sequence." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1347> a skos:Concept ;
    skos:prefLabel "Dirichlet distribution" ;
    skos:definition "Dirichlet distribution used by hidden Markov model analysis programs." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1352> a skos:Concept ;
    skos:prefLabel "Regular expression" ;
    skos:definition "Regular expression pattern." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1353> a skos:Concept ;
    skos:prefLabel "Sequence motif" ;
    skos:definition "Any specific or conserved pattern (typically expressed as a regular expression) in a molecular sequence." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1354> a skos:Concept ;
    skos:prefLabel "Sequence profile" ;
    skos:definition "Some type of statistical model representing a (typically multiple) sequence alignment." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1355> a skos:Concept ;
    skos:prefLabel "Protein signature" ;
    skos:definition "An informative report about a specific or conserved protein sequence pattern." ;
    skos:altLabel "Protein site signature" ;
    skos:altLabel "Protein repeat signature" ;
    skos:altLabel "Protein family signature" ;
    skos:altLabel "Protein domain signature" ;
    skos:altLabel "InterPro entry" ;
    skos:altLabel "Protein region signature" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1361> a skos:Concept ;
    skos:prefLabel "Position frequency matrix" ;
    skos:definition "A profile (typically representing a sequence alignment) that is a simple matrix of nucleotide (or amino acid) counts per position." ;
    skos:altLabel "PFM" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1362> a skos:Concept ;
    skos:prefLabel "Position weight matrix" ;
    skos:definition "A profile (typically representing a sequence alignment) that is weighted matrix of nucleotide (or amino acid) counts per position." ;
    skos:altLabel "PWM" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1363> a skos:Concept ;
    skos:prefLabel "Information content matrix" ;
    skos:definition "A profile (typically representing a sequence alignment) derived from a matrix of nucleotide (or amino acid) counts per position that reflects information content at each position." ;
    skos:altLabel "ICM" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1364> a skos:Concept ;
    skos:prefLabel "Hidden Markov model" ;
    skos:definition "A statistical Markov model of a system which is assumed to be a Markov process with unobserved (hidden) states.  For example, a hidden Markov model representation of a set or alignment of sequences." ;
    skos:altLabel "HMM" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1365> a skos:Concept ;
    skos:prefLabel "Fingerprint" ;
    skos:definition "One or more fingerprints (sequence classifiers) as used in the PRINTS database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1381> a skos:Concept ;
    skos:prefLabel "Pair sequence alignment" ;
    skos:definition "Alignment of exactly two molecular sequences." ;
    skos:altLabel "Sequence alignment (pair)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1383> a skos:Concept ;
    skos:prefLabel "Nucleic acid sequence alignment" ;
    skos:definition "Alignment of multiple nucleotide sequences." ;
    skos:altLabel "Sequence alignment (nucleic acid)" ;
    skos:altLabel "RNA sequence alignment" ;
    skos:altLabel "DNA sequence alignment" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1384> a skos:Concept ;
    skos:prefLabel "Protein sequence alignment" ;
    skos:definition "Alignment of multiple protein sequences." ;
    skos:altLabel "Sequence alignment (protein)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1385> a skos:Concept ;
    skos:prefLabel "Hybrid sequence alignment" ;
    skos:definition "Alignment of multiple molecular sequences of different types." ;
    skos:altLabel "Sequence alignment (hybrid)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1394> a skos:Concept ;
    skos:prefLabel "Alignment score or penalty" ;
    skos:definition "A simple floating point number defining the penalty for opening or extending a gap in an alignment." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1397> a skos:Concept ;
    skos:prefLabel "Gap opening penalty" ;
    skos:definition "A penalty for opening a gap in an alignment." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1398> a skos:Concept ;
    skos:prefLabel "Gap extension penalty" ;
    skos:definition "A penalty for extending a gap in an alignment." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1399> a skos:Concept ;
    skos:prefLabel "Gap separation penalty" ;
    skos:definition "A penalty for gaps that are close together in an alignment." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1401> a skos:Concept ;
    skos:prefLabel "Match reward score" ;
    skos:definition "The score for a 'match' used in various sequence database search applications with simple scoring schemes." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1402> a skos:Concept ;
    skos:prefLabel "Mismatch penalty score" ;
    skos:definition "The score (penalty) for a 'mismatch' used in various alignment and sequence database search applications with simple scoring schemes." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1403> a skos:Concept ;
    skos:prefLabel "Drop off score" ;
    skos:definition "This is the threshold drop in score at which extension of word alignment is halted." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1410> a skos:Concept ;
    skos:prefLabel "Terminal gap opening penalty" ;
    skos:definition "A number defining the penalty for opening gaps at the termini of an alignment, either from the N/C terminal of protein or 5'/3' terminal of nucleotide sequences." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1411> a skos:Concept ;
    skos:prefLabel "Terminal gap extension penalty" ;
    skos:definition "A number defining the penalty for extending gaps at the termini of an alignment, either from the N/C terminal of protein or 5'/3' terminal of nucleotide sequences." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1412> a skos:Concept ;
    skos:prefLabel "Sequence identity" ;
    skos:definition "Sequence identity is the number (%) of matches (identical characters) in positions from an alignment of two molecular sequences." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1413> a skos:Concept ;
    skos:prefLabel "Sequence similarity" ;
    skos:definition "Sequence similarity is the similarity (expressed as a percentage) of two molecular sequences calculated from their alignment, a scoring matrix for scoring characters substitutions and penalties for gap insertion and extension." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1426> a skos:Concept ;
    skos:prefLabel "Phylogenetic continuous quantitative data" ;
    skos:definition "Continuous quantitative data that may be read during phylogenetic tree calculation." ;
    skos:altLabel "Quantitative traits" ;
    skos:altLabel "Phylogenetic continuous quantitative characters" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1427> a skos:Concept ;
    skos:prefLabel "Phylogenetic discrete data" ;
    skos:definition "Character data with discrete states that may be read during phylogenetic tree calculation." ;
    skos:altLabel "Discrete characters" ;
    skos:altLabel "Phylogenetic discrete states" ;
    skos:altLabel "Discretely coded characters" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1428> a skos:Concept ;
    skos:prefLabel "Phylogenetic character cliques" ;
    skos:definition "One or more cliques of mutually compatible characters that are generated, for example from analysis of discrete character data, and are used to generate a phylogeny." ;
    skos:altLabel "Phylogenetic report (cliques)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1429> a skos:Concept ;
    skos:prefLabel "Phylogenetic invariants" ;
    skos:definition "Phylogenetic invariants data for testing alternative tree topologies." ;
    skos:altLabel "Phylogenetic report (invariants)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1439> a skos:Concept ;
    skos:prefLabel "DNA substitution model" ;
    skos:definition "A model of DNA substitution that explains a DNA sequence alignment, derived from phylogenetic tree analysis." ;
    skos:altLabel "Phylogenetic tree report (DNA substitution model)" ;
    skos:altLabel "Substitution model" ;
    skos:altLabel "Sequence alignment report (DNA substitution model)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1442> a skos:Concept ;
    skos:prefLabel "Phylogenetic tree distances" ;
    skos:definition "Distances, such as Branch Score distance, between two or more phylogenetic trees." ;
    skos:altLabel "Phylogenetic tree report (tree distances)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1444> a skos:Concept ;
    skos:prefLabel "Phylogenetic character contrasts" ;
    skos:definition "Independent contrasts for characters used in a phylogenetic tree, or covariances, regressions and correlations between characters for those contrasts." ;
    skos:altLabel "Phylogenetic report (character contrasts)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1448> a skos:Concept ;
    skos:prefLabel "Comparison matrix (nucleotide)" ;
    skos:definition "Matrix of integer or floating point numbers for nucleotide comparison." ;
    skos:altLabel "Nucleotide comparison matrix" ;
    skos:altLabel "Nucleotide substitution matrix" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1449> a skos:Concept ;
    skos:prefLabel "Comparison matrix (amino acid)" ;
    skos:definition "Matrix of integer or floating point numbers for amino acid comparison." ;
    skos:altLabel "Amino acid comparison matrix" ;
    skos:altLabel "Amino acid substitution matrix" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1459> a skos:Concept ;
    skos:prefLabel "Nucleic acid structure" ;
    skos:definition "3D coordinate and associated data for a nucleic acid tertiary (3D) structure." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1460> a skos:Concept ;
    skos:prefLabel "Protein structure" ;
    skos:definition "3D coordinate and associated data for a protein tertiary (3D) structure, or part of a structure, possibly in complex with other molecules." ;
    skos:altLabel "Protein structures" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1461> a skos:Concept ;
    skos:prefLabel "Protein-ligand complex" ;
    skos:definition "The structure of a protein in complex with a ligand, typically a small molecule such as an enzyme substrate or cofactor, but possibly another macromolecule." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1462> a skos:Concept ;
    skos:prefLabel "Carbohydrate structure" ;
    skos:definition "3D coordinate and associated data for a carbohydrate (3D) structure." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1463> a skos:Concept ;
    skos:prefLabel "Small molecule structure" ;
    skos:definition "3D coordinate and associated data for the (3D) structure of a small molecule, such as any common chemical compound." ;
    skos:altLabel "CHEBI:23367" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1464> a skos:Concept ;
    skos:prefLabel "DNA structure" ;
    skos:definition "3D coordinate and associated data for a DNA tertiary (3D) structure." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1465> a skos:Concept ;
    skos:prefLabel "RNA structure" ;
    skos:definition "3D coordinate and associated data for an RNA tertiary (3D) structure." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1466> a skos:Concept ;
    skos:prefLabel "tRNA structure" ;
    skos:definition "3D coordinate and associated data for a tRNA tertiary (3D) structure, including tmRNA, snoRNAs etc." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1467> a skos:Concept ;
    skos:prefLabel "Protein chain" ;
    skos:definition "3D coordinate and associated data for the tertiary (3D) structure of a polypeptide chain." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1468> a skos:Concept ;
    skos:prefLabel "Protein domain" ;
    skos:definition "3D coordinate and associated data for the tertiary (3D) structure of a protein domain." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1470> a skos:Concept ;
    skos:prefLabel "C-alpha trace" ;
    skos:definition "3D coordinate and associated data for a protein tertiary (3D) structure (typically C-alpha atoms only)." ;
    skos:altLabel "Protein structure (C-alpha atoms)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1479> a skos:Concept ;
    skos:prefLabel "Structure alignment (pair)" ;
    skos:definition "Alignment (superimposition) of exactly two molecular tertiary (3D) structures." ;
    skos:altLabel "Pair structure alignment" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1481> a skos:Concept ;
    skos:prefLabel "Protein structure alignment" ;
    skos:definition "Alignment (superimposition) of protein tertiary (3D) structures." ;
    skos:altLabel "Structure alignment (protein)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1482> a skos:Concept ;
    skos:prefLabel "Nucleic acid structure alignment" ;
    skos:definition "Alignment (superimposition) of nucleic acid tertiary (3D) structures." ;
    skos:altLabel "Structure alignment (nucleic acid)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1493> a skos:Concept ;
    skos:prefLabel "RNA structure alignment" ;
    skos:definition "Alignment (superimposition) of RNA tertiary (3D) structures." ;
    skos:altLabel "Structure alignment (RNA)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1494> a skos:Concept ;
    skos:prefLabel "Structural transformation matrix" ;
    skos:definition "Matrix to transform (rotate/translate) 3D coordinates, typically the transformation necessary to superimpose two molecular structures." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1497> a skos:Concept ;
    skos:prefLabel "Root-mean-square deviation" ;
    skos:definition "Root-mean-square deviation (RMSD) is calculated to measure the average distance between superimposed macromolecular coordinates." ;
    skos:altLabel "RMSD" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1498> a skos:Concept ;
    skos:prefLabel "Tanimoto similarity score" ;
    skos:definition "A measure of the similarity between two ligand fingerprints." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1499> a skos:Concept ;
    skos:prefLabel "3D-1D scoring matrix" ;
    skos:definition "A matrix of 3D-1D scores reflecting the probability of amino acids to occur in different tertiary structural environments." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1501> a skos:Concept ;
    skos:prefLabel "Amino acid index" ;
    skos:definition "A table of 20 numerical values which quantify a property (e.g. physicochemical or biochemical) of the common amino acids." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1502> a skos:Concept ;
    skos:prefLabel "Amino acid index (chemical classes)" ;
    skos:definition "Chemical classification (small, aliphatic, aromatic, polar, charged etc) of amino acids." ;
    skos:altLabel "Chemical classes (amino acids)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1503> a skos:Concept ;
    skos:prefLabel "Amino acid pair-wise contact potentials" ;
    skos:definition "Statistical protein contact potentials." ;
    skos:altLabel "Contact potentials (amino acid pair-wise)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1505> a skos:Concept ;
    skos:prefLabel "Amino acid index (molecular weight)" ;
    skos:definition "Molecular weights of amino acids." ;
    skos:altLabel "Molecular weight (amino acids)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1506> a skos:Concept ;
    skos:prefLabel "Amino acid index (hydropathy)" ;
    skos:definition "Hydrophobic, hydrophilic or charge properties of amino acids." ;
    skos:altLabel "Hydropathy (amino acids)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1507> a skos:Concept ;
    skos:prefLabel "Amino acid index (White-Wimley data)" ;
    skos:definition "Experimental free energy values for the water-interface and water-octanol transitions for the amino acids." ;
    skos:altLabel "White-Wimley data (amino acids)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1508> a skos:Concept ;
    skos:prefLabel "Amino acid index (van der Waals radii)" ;
    skos:definition "Van der Waals radii of atoms for different amino acid residues." ;
    skos:altLabel "van der Waals radii (amino acids)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1519> a skos:Concept ;
    skos:prefLabel "Peptide molecular weights" ;
    skos:definition "List of molecular weight(s) of one or more proteins or peptides, for example cut by proteolytic enzymes or reagents." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1520> a skos:Concept ;
    skos:prefLabel "Peptide hydrophobic moment" ;
    skos:definition "Report on the hydrophobic moment of a polypeptide sequence." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1521> a skos:Concept ;
    skos:prefLabel "Protein aliphatic index" ;
    skos:definition "The aliphatic index of a protein." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1522> a skos:Concept ;
    skos:prefLabel "Protein sequence hydropathy plot" ;
    skos:definition "A protein sequence with annotation on hydrophobic or hydrophilic / charged regions, hydrophobicity plot etc." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1523> a skos:Concept ;
    skos:prefLabel "Protein charge plot" ;
    skos:definition "A plot of the mean charge of the amino acids within a window of specified length as the window is moved along a protein sequence." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1524> a skos:Concept ;
    skos:prefLabel "Protein solubility" ;
    skos:definition "The solubility or atomic solvation energy of a protein sequence or structure." ;
    skos:altLabel "Protein solubility data" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1525> a skos:Concept ;
    skos:prefLabel "Protein crystallizability" ;
    skos:definition "Data on the crystallizability of a protein sequence." ;
    skos:altLabel "Protein crystallizability data" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1526> a skos:Concept ;
    skos:prefLabel "Protein globularity" ;
    skos:definition "Data on the stability, intrinsic disorder or globularity of a protein sequence." ;
    skos:altLabel "Protein globularity data" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1527> a skos:Concept ;
    skos:prefLabel "Protein titration curve" ;
    skos:definition "The titration curve of a protein." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1528> a skos:Concept ;
    skos:prefLabel "Protein isoelectric point" ;
    skos:definition "The isoelectric point of one proteins." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1529> a skos:Concept ;
    skos:prefLabel "Protein pKa value" ;
    skos:definition "The pKa value of a protein." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1530> a skos:Concept ;
    skos:prefLabel "Protein hydrogen exchange rate" ;
    skos:definition "The hydrogen exchange rate of a protein." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1531> a skos:Concept ;
    skos:prefLabel "Protein extinction coefficient" ;
    skos:definition "The extinction coefficient of a protein." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1532> a skos:Concept ;
    skos:prefLabel "Protein optical density" ;
    skos:definition "The optical density of a protein." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1534> a skos:Concept ;
    skos:prefLabel "Peptide immunogenicity data" ;
    skos:definition "An report on allergenicity / immunogenicity of peptides and proteins." ;
    skos:altLabel "Peptide immunogenicity" ;
    skos:altLabel "Peptide immunogenicity report" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1537> a skos:Concept ;
    skos:prefLabel "Protein structure report" ;
    skos:definition "A human-readable collection of information about one or more specific protein 3D structure(s) or structural domains." ;
    skos:altLabel "Protein structure report (domain)" ;
    skos:altLabel "Protein structure-derived report" ;
    skos:altLabel "Protein structural property" ;
    skos:altLabel "Protein property (structural)" ;
    skos:altLabel "Protein report (structure)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1539> a skos:Concept ;
    skos:prefLabel "Protein structural quality report" ;
    skos:definition "Report on the quality of a protein three-dimensional model." ;
    skos:altLabel "Protein structure report (quality evaluation)" ;
    skos:altLabel "Protein structure validation report" ;
    skos:altLabel "Protein property (structural quality)" ;
    skos:altLabel "Protein report (structural quality)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_1542> a skos:Concept ;
