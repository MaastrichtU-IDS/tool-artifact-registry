<http://edamontology.org/topic_0091> a skos:Concept ;
    skos:prefLabel "Bioinformatics" ;
    skos:definition "The archival, curation, processing and analysis of complex biological data." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_0092> a skos:Concept ;
    skos:prefLabel "Data visualisation" ;
    skos:definition "Rendering (drawing on a computer screen) or visualisation of molecular sequences, structures or other biomolecular data." ;
    skos:altLabel "Computer graphics" ;
    skos:altLabel "Data rendering" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_0097> a skos:Concept ;
    skos:prefLabel "Nucleic acid structure analysis" ;
    skos:definition "The archival, curation, processing and analysis of nucleic acid structural information, such as whole structures, structural features and alignments, and associated annotation." ;
