    skos:prefLabel "Biosafety report" ;
    skos:definition "A human-readable collection of information concerning biosafety data." ;
    skos:altLabel "Biosafety information" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3717> a skos:Concept ;
    skos:prefLabel "Isolation report" ;
    skos:definition "A report about any kind of isolation of biological material." ;
    skos:altLabel "Geographic location" ;
    skos:altLabel "Isolation source" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3718> a skos:Concept ;
    skos:prefLabel "Pathogenicity report" ;
    skos:definition "Information about the ability of an organism to cause disease in a corresponding host." ;
    skos:altLabel "Pathogenicity" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3719> a skos:Concept ;
    skos:prefLabel "Biosafety classification" ;
    skos:definition "Information about the biosafety classification of an organism according to corresponding law." ;
    skos:altLabel "Biosafety level" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3720> a skos:Concept ;
    skos:prefLabel "Geographic location" ;
    skos:definition "A report about localisation of the isolaton of biological material e.g. country or coordinates." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3721> a skos:Concept ;
    skos:prefLabel "Isolation source" ;
    skos:definition "A report about any kind of isolation source of biological material e.g. blood, water, soil." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3722> a skos:Concept ;
    skos:prefLabel "Physiology parameter" ;
    skos:definition "Experimentally determined parameter of the physiology of an organism, e.g. substrate spectrum." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3723> a skos:Concept ;
    skos:prefLabel "Morphology parameter" ;
    skos:definition "Experimentally determined parameter of the morphology of an organism, e.g. size & shape." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3724> a skos:Concept ;
    skos:prefLabel "Cultivation parameter" ;
    skos:definition "Experimental determined parameter for the cultivation of an organism." ;
    skos:altLabel "Cultivation conditions" ;
    skos:altLabel "Salinity" ;
    skos:altLabel "Nitrogen source" ;
    skos:altLabel "Culture media composition" ;
    skos:altLabel "pH value" ;
    skos:altLabel "Carbon source" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3732> a skos:Concept ;
    skos:prefLabel "Sequencing metadata name" ;
    skos:definition "Data concerning a sequencing experiment, that may be specified as an input to some tool." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3733> a skos:Concept ;
    skos:prefLabel "Flow cell identifier" ;
    skos:definition "An identifier of a flow cell of a sequencing machine." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3734> a skos:Concept ;
    skos:prefLabel "Lane identifier" ;
    skos:definition "An identifier of a lane within a flow cell of a sequencing machine, within which millions of sequences are immobilised, amplified and sequenced." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3735> a skos:Concept ;
    skos:prefLabel "Run number" ;
    skos:definition "A number corresponding to the number of an analysis performed by a sequencing machine.  For example, if it's the 13th analysis, the run is 13." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3736> a skos:Concept ;
    skos:prefLabel "Ecological data" ;
    skos:definition "Data concerning ecology; for example measurements and reports from the study of interactions among organisms and their environment." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3737> a skos:Concept ;
    skos:prefLabel "Alpha diversity data" ;
    skos:definition "The mean species diversity in sites or habitats at a local scale." ;
    skos:altLabel "α-diversity" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3738> a skos:Concept ;
    skos:prefLabel "Beta diversity data" ;
    skos:definition "The ratio between regional and local species diversity." ;
    skos:altLabel "True beta diversity" ;
    skos:altLabel "β-diversity" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3739> a skos:Concept ;
    skos:prefLabel "Gamma diversity data" ;
    skos:definition "The total species diversity in a landscape." ;
    skos:altLabel "ɣ-diversity" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3743> a skos:Concept ;
    skos:prefLabel "Ordination plot" ;
    skos:definition "A plot in which community data (e.g. species abundance data) is summarised.  Similar species and samples are plotted close together, and dissimilar species and samples are plotted placed far apart." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3753> a skos:Concept ;
    skos:prefLabel "Over-representation data" ;
    skos:definition "A ranked list of categories (usually ontology concepts), each associated with a statistical metric of over-/under-representation within the studied data." ;
    skos:altLabel "Over-representation report" ;
    skos:altLabel "Enrichment report" ;
    skos:altLabel "Functional enrichment report" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3754> a skos:Concept ;
    skos:prefLabel "GO-term enrichment data" ;
    skos:definition "A ranked list of Gene Ontology concepts, each associated with a p-value, concerning or derived from the analysis of e.g. a set of genes or proteins." ;
    skos:altLabel "GO-term report" ;
    skos:altLabel "Gene ontology term enrichment report" ;
    skos:altLabel "Gene ontology enrichment report" ;
    skos:altLabel "GO-term enrichment report" ;
    skos:altLabel "Gene ontology concept over-representation report" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3756> a skos:Concept ;
    skos:prefLabel "Localisation score" ;
    skos:definition "Score for localization of one or more post-translational modifications in peptide sequence measured by mass spectrometry." ;
    skos:altLabel "PTM localisation" ;
    skos:altLabel "False localisation rate" ;
    skos:altLabel "PTM score" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3757> a skos:Concept ;
    skos:prefLabel "Unimod ID" ;
    skos:definition "Identifier of a protein modification catalogued in the Unimod database." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3759> a skos:Concept ;
    skos:prefLabel "ProteomeXchange ID" ;
    skos:definition "Identifier for mass spectrometry proteomics data in the proteomexchange.org repository." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3768> a skos:Concept ;
    skos:prefLabel "Clustered expression profiles" ;
    skos:definition "Groupings of expression profiles according to a clustering algorithm." ;
    skos:altLabel "Clustered gene expression profiles" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3769> a skos:Concept ;
    skos:prefLabel "BRENDA ontology concept ID" ;
    skos:definition "An identifier of a concept from the BRENDA ontology." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3779> a skos:Concept ;
    skos:prefLabel "Annotated text" ;
    skos:definition "A text (such as a scientific article), annotated with notes, data and metadata, such as recognised entities, concepts, and their relations." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3786> a skos:Concept ;
    skos:prefLabel "Query script" ;
    skos:definition "A structured query, in form of a script, that defines a database search task." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3805> a skos:Concept ;
    skos:prefLabel "3D EM Map" ;
    skos:definition "Structural 3D model (volume map) from electron microscopy." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3806> a skos:Concept ;
    skos:prefLabel "3D EM Mask" ;
    skos:definition "Annotation on a structural 3D EM Map from electron microscopy. This might include one or several locations in the map of the known features of a particular macromolecule." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3807> a skos:Concept ;
    skos:prefLabel "EM Movie" ;
    skos:definition "Raw DDD movie acquisition from electron microscopy." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3808> a skos:Concept ;
    skos:prefLabel "EM Micrograph" ;
    skos:definition "Raw acquistion from electron microscopy or average of an aligned DDD movie." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3842> a skos:Concept ;
    skos:prefLabel "Molecular simulation data" ;
    skos:definition "Data coming from molecular simulations, computer \"experiments\" on model molecules." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3856> a skos:Concept ;
    skos:prefLabel "RNA central ID" ;
    skos:definition "Identifier of an entry from the RNA central database of annotated human miRNAs." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3861> a skos:Concept ;
    skos:prefLabel "Electronic health record" ;
    skos:definition "A human-readable systematic collection of patient (or population) health information in a digital format." ;
    skos:altLabel "EMR" ;
    skos:altLabel "Electronic medical record" ;
    skos:altLabel "EHR" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3869> a skos:Concept ;
    skos:prefLabel "Simulation" ;
    skos:definition "Data coming from molecular simulations, computer \"experiments\" on model molecules. Tipically formed by two separated but indivisible pieces of information: topology data (static) and trajectory data (dynamic)." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3870> a skos:Concept ;
    skos:prefLabel "Trajectory data" ;
    skos:definition "Dynamic information of a structure molecular system coming from a molecular simulation: XYZ 3D coordinates (sometimes with their associated velocities) for every atom along time." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3871> a skos:Concept ;
    skos:prefLabel "Forcefield parameters" ;
    skos:definition "Force field parameters: charges, masses, radii, bond lengths, bond dihedrals, etc. define the structural molecular system, and are essential for the proper description and simulation of a molecular system." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3872> a skos:Concept ;
    skos:prefLabel "Topology data" ;
    skos:definition "Static information of a structure molecular system that is needed for a molecular simulation: the list of atoms, their non-bonded parameters for Van der Waals and electrostatic interactions, and the complete connectivity in terms of bonds, angles and dihedrals." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3905> a skos:Concept ;
    skos:prefLabel "Histogram" ;
    skos:definition "Visualization of distribution of quantitative data, e.g. expression data, by histograms, violin plots and density plots." ;
    skos:altLabel "Density plot" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3914> a skos:Concept ;
    skos:prefLabel "Quality control report" ;
    skos:definition "A human-readable collection of information about about how a scientific experiment or analysis was carried out that results in a specific set of data or results used for further analysis or to test a specific hypothesis." ;
    skos:altLabel "Quality control metrics" ;
    skos:altLabel "QC metrics" ;
    skos:altLabel "QC report" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3917> a skos:Concept ;
    skos:prefLabel "Count matrix" ;
    skos:definition "A table of unnormalized values representing summarised read counts per genomic region (e.g. gene, transcript, peak)." ;
    skos:altLabel "Read count matrix" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3924> a skos:Concept ;
    skos:prefLabel "DNA structure alignment" ;
    skos:definition "Alignment (superimposition) of DNA tertiary (3D) structures." ;
    skos:altLabel "Structure alignment (DNA)" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3932> a skos:Concept ;
    skos:prefLabel "Q-value" ;
    skos:definition "A score derived from the P-value to ensure correction for multiple tests. The Q-value provides an estimate of the positive False Discovery Rate (pFDR), i.e. the rate of false positives among all the cases reported positive: pFDR = FP / (FP + TP)." ;
    skos:altLabel "FDR" ;
    skos:altLabel "Padj" ;
    skos:altLabel "Adjusted P-value" ;
    skos:altLabel "pFDR" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3949> a skos:Concept ;
    skos:prefLabel "Profile HMM" ;
    skos:definition "A profile HMM is a variant of a Hidden Markov model that is derived specifically from a set of (aligned) biological sequences. Profile HMMs provide the basis for a position-specific scoring system, which can be used to align sequences and search databases for related sequences." ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3952> a skos:Concept ;
    skos:prefLabel "Pathway ID (WikiPathways)" ;
    skos:definition "Identifier of a pathway from the WikiPathways pathway database." ;
    skos:altLabel "WikiPathways pathway ID" ;
    skos:altLabel "WikiPathways ID" ;
    tar:conceptBranch "data" .

<http://edamontology.org/data_3953> a skos:Concept ;
    skos:prefLabel "Pathway overrepresentation data" ;
    skos:definition "A ranked list of pathways, each associated with z-score, p-value or similar, concerning or derived from the analysis of e.g. a set of genes or proteins." ;
    skos:altLabel "Pathway report" ;
    skos:altLabel "Pathway analysis results" ;
    skos:altLabel "Pathway enrichment report" ;
    skos:altLabel "Pathway term enrichment report" ;
    skos:altLabel "Pathway over-representation report" ;
    tar:conceptBranch "data" .

<http://edamontology.org/topic_0003> a skos:Concept ;
    skos:prefLabel "Topic" ;
    skos:definition "A category denoting a rather broad domain or field of interest, of study, application, work, data, or technology. Topics have no clearly defined borders between each other." ;
    skos:altLabel "sumo:FieldOfStudy" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_0077> a skos:Concept ;
    skos:prefLabel "Nucleic acids" ;
    skos:definition "The processing and analysis of nucleic acid sequence, structural and other data." ;
    skos:altLabel "Nucleic acid informatics" ;
    skos:altLabel "Nucleic acid bioinformatics" ;
    skos:altLabel "Nucleic acid physicochemistry" ;
    skos:altLabel "Nucleic acid properties" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_0078> a skos:Concept ;
    skos:prefLabel "Proteins" ;
    skos:definition "Archival, processing and analysis of protein data, typically molecular sequence and structural data." ;
    skos:altLabel "Protein informatics" ;
    skos:altLabel "Protein bioinformatics" ;
    skos:altLabel "Protein databases" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_0080> a skos:Concept ;
    skos:prefLabel "Sequence analysis" ;
    skos:definition "The archival, processing and analysis of molecular sequences (monomer composition of polymers) including molecular sequence data resources, sequence sites, alignments, motifs and profiles." ;
    skos:altLabel "Sequences" ;
    skos:altLabel "Biological sequences" ;
    skos:altLabel "Sequence databases" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_0081> a skos:Concept ;
    skos:prefLabel "Structure analysis" ;
    skos:definition "The curation, processing, analysis and prediction of data about the structure of biological molecules, typically proteins and nucleic acids and other macromolecules." ;
    skos:altLabel "Structural bioinformatics" ;
    skos:altLabel "Biomolecular structure" ;
    skos:altLabel "Structure databases" ;
    skos:altLabel "Structures" ;
    skos:altLabel "Molecular structure" ;
    skos:altLabel "Computational structural biology" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_0082> a skos:Concept ;
    skos:prefLabel "Structure prediction" ;
    skos:definition "The prediction of molecular structure, including the prediction, modelling, recognition or design of protein secondary or tertiary structure or other structural features, and the folding of nucleic acid molecules and the prediction or design of nucleic acid (typically RNA) sequences with specific conformations." ;
    skos:altLabel "RNA structure prediction" ;
    skos:altLabel "Nucleic acid folding" ;
    skos:altLabel "Nucleic acid design" ;
    skos:altLabel "DNA structure prediction" ;
    skos:altLabel "Protein fold recognition" ;
    skos:altLabel "Protein structure prediction" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_0084> a skos:Concept ;
    skos:prefLabel "Phylogeny" ;
