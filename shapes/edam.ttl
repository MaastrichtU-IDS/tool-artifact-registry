    skos:altLabel "Exome" ;
    skos:altLabel "Targeted exome capture" ;
    skos:altLabel "Exome analysis" ;
    skos:altLabel "Exome capture" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3678> a skos:Concept ;
    skos:prefLabel "Experimental design and studies" ;
    skos:definition "The design of an experiment intended to test a hypothesis, and describe or explain empirical data obtained under various experimental conditions." ;
    skos:altLabel "Design of experiments" ;
    skos:altLabel "Studies" ;
    skos:altLabel "Experimental design" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3679> a skos:Concept ;
    skos:prefLabel "Animal study" ;
    skos:definition "The design of an experiment involving non-human animals." ;
    skos:altLabel "Challenge study" ;
