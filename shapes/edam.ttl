<http://edamontology.org/topic_0140> a skos:Concept ;
    skos:prefLabel "Protein targeting and localisation" ;
    skos:definition "The study of how proteins are transported within and without the cell, including signal peptides, protein subcellular localisation and export." ;
    skos:altLabel "Protein sorting" ;
    skos:altLabel "Protein targeting" ;
    skos:altLabel "Protein localisation" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_0152> a skos:Concept ;
    skos:prefLabel "Carbohydrates" ;
    skos:definition "Carbohydrates, typically including structural information." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_0153> a skos:Concept ;
    skos:prefLabel "Lipids" ;
    skos:definition "Lipids and their structures." ;
