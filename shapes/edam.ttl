    skos:altLabel "Active learning" ;
    skos:altLabel "Knowledge representation" ;
    skos:altLabel "Unsupervised learning" ;
    skos:altLabel "Ensembl learning" ;
    skos:altLabel "Neural networks" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3489> a skos:Concept ;
    skos:prefLabel "Database management" ;
