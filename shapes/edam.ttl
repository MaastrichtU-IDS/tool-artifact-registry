<http://edamontology.org/topic_3574> a skos:Concept ;
    skos:prefLabel "Human genetics" ;
    skos:definition "The study of inheritance in human beings." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3575> a skos:Concept ;
    skos:prefLabel "Tropical medicine" ;
    skos:definition "Health problems that are prevalent in tropical and subtropical regions." ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3576> a skos:Concept ;
    skos:prefLabel "Medical biotechnology" ;
    skos:definition "Biotechnology applied to the medical sciences and the development of medicines." ;
    skos:altLabel "Pharmaceutical biotechnology" ;
    tar:conceptBranch "topic-edam" .

<http://edamontology.org/topic_3577> a skos:Concept ;
    skos:prefLabel "Personalised medicine" ;
